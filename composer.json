{
    "name": "welfare/notifications",
    "description": "Shared customer SMS/push notification dispatch for Laravel apps — swappable SMS providers (Termii, Africa's Talking, Twilio) and push (Firebase), driven by config so a provider can be swapped via one env var. No app-domain coupling: takes a plain Recipient value object, not an Eloquent model, so it works the same in any host app regardless of its user schema.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "kreait/firebase-php": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Welfare\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Welfare\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Welfare\\Notifications\\NotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
